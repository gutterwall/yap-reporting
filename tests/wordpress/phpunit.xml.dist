<?xml version="1.0"?>
<phpunit
    bootstrap="bootstrap.php"
    colors="true"
    beStrictAboutTestsThatDoNotTestAnything="true"
    convertDeprecationsToExceptions="true"
>
    <testsuites>
        <testsuite name="wordpress">
            <directory suffix="Test.php">./Integration</directory>
        </testsuite>
    </testsuites>
</phpunit>
