{
    "name": "gutterwall/yap-reporting",
    "description": "YAP Reporting: WordPress plugin and webservice for YAP phoneline statistics, with a fake YAP backend for testing.",
    "type": "project",
    "license": "MIT",
    "require": {
        "php": ">=8.1"
    },
    "require-dev": {
        "phpunit/phpunit": "^9.6",
        "yoast/phpunit-polyfills": "^2.0",
        "wp-coding-standards/wpcs": "^3.1",
        "phpcompatibility/phpcompatibility-wp": "^2.1",
        "dealerdirect/phpcodesniffer-composer-installer": "^1.0",
        "phpstan/phpstan": "^2.1",
        "szepeviktor/phpstan-wordpress": "^2.0",
        "phpstan/extension-installer": "^1.4"
    },
    "scripts": {
        "test:webservice": "php webservice/reporting-api/tests/run.php",
        "test:plugin-unit": "php wordpress/yap-reporting/tests/run.php",
        "test:service": "php tests/service/run.php",
        "test:wordpress": "phpunit -c tests/wordpress/phpunit.xml.dist",
        "lint": "phpcs",
        "analyse": "phpstan analyse --memory-limit=2G"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true,
            "phpstan/extension-installer": true
        }
    }
}
